# Runtime Data API and Supabase Auth configuration. The publishable key is
# intended for authenticated clients and does not bypass row-level security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only HMAC key for short-lived, tamper-evident order price intents.
# Generate at least 32 random characters and never expose this value to clients.
ORDER_INTENT_SIGNING_SECRET=replace_with_at_least_32_random_characters

# Local migration tooling only. Never expose this value to a browser or commit
# it to source control. Prefer a newly rotated password and a direct connection.
SUPABASE_DB_URL=postgresql://postgres:replace_me@db.your-project-ref.supabase.co:5432/postgres
